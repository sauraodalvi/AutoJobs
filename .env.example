# LLM API Credentials (Choose OpenRouter or Groq)
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Email Credentials for IMAP & SMTP (For Gmail, use App Password)
EMAIL_USER=sauraodalvi97@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# Email Server Settings
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# LLM Model Choice
LLM_MODEL=openrouter/google/gemini-2.5-flash

# Execution Parameters
DAYS_BETWEEN_FOLLOWUP=3
MAX_FOLLOWUPS=2
